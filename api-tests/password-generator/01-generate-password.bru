meta {
  name: Generate Password
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/passwords/generate?length=12
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains application/json
  res.body.length: eq 12
  res.body.password: isDefined
  res.body.timestamp: isDefined
}

tests {
  test("should return 200 OK with password payload", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.length).to.equal(12);
    expect(body.password).to.be.a('string');
    expect(body.password).to.have.lengthOf(12);
    expect(body.timestamp).to.be.a('string');
  });
}
