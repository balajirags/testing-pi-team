meta {
  name: Encode Text to Base64
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/base64/encode
  body: json
  auth: none
}

body:json {
  {
    "text": "Hello World"
  }
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains application/json
  res.body.originalText: eq Hello World
  res.body.encodedText: eq SGVsbG8gV29ybGQ=
}

tests {
  test("should return 200 OK with base64 encoded string", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.originalText).to.equal("Hello World");
    expect(body.encodedText).to.equal("SGVsbG8gV29ybGQ=");
  });
}
