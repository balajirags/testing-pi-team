meta {
  name: Get Campaign Analytics
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/campaigns/11111111-1111-1111-1111-111111111111/analytics?startDate=2026-08-01&endDate=2026-08-15
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains application/json
  res.body.campaignId: isDefined
  res.body.summary: isDefined
  res.body.dailyBreakdown: isDefined
}

tests {
  test("should return 200 OK with analytics payload", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.campaignId).to.equal("11111111-1111-1111-1111-111111111111");
    expect(body.summary).to.be.an('object');
    expect(body.dailyBreakdown).to.be.an('array');
  });
}
