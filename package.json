{
  "name": "devsquad",
  "version": "1.0.0",
  "description": "DevSquad AI — Autonomous Multi-Agent Engineering Squad (BA, Dev, QA, Reviewer in tmux)",
  "main": "dist/index.js",
  "bin": {
    "devsquad": "./bin/devsquad.js"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
